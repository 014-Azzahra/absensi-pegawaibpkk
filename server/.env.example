# Salin file ini menjadi .env lalu sesuaikan. Semua nilai di bawah OPSIONAL (ada nilai bawaan).
PORT=3000
# JWT_SECRET=isi-dengan-string-acak-panjang     # jika kosong dibuat otomatis di data/jwt.secret
# JWT_EXPIRES=12h

# Lokasi kantor & aturan presensi (divalidasi di server)
KANTOR_LAT=-3.971464128431429
KANTOR_LON=122.51444925176875
RADIUS_METER=500
JAM_MASUK=08:00
JAM_PULANG=16:00
BATAS_TERLAMBAT=08:30
ZONA_WAKTU=Asia/Makassar

# Akun awal (hanya dipakai saat database pertama kali dibuat)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PEGAWAI_PASSWORD_AWAL=pegawai123

# (Opsional) URL Web App Google Apps Script untuk sinkronisasi ke Google Sheets
# SHEETS_WEBHOOK_URL=
